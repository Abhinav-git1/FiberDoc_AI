DATABASE_URL=postgresql+psycopg://fiberdoc:fiberdoc@localhost:5432/fiberdoc
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried when the main model is overloaded (503) or too slow (504). Leave empty for no fallback.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
# Seconds per request, and in total per call (retries and fallback included).
GEMINI_TIMEOUT_S=30
GEMINI_CALL_BUDGET_S=60
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
UPLOAD_DIR=data/uploads
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
